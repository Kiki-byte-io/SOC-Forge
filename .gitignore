# --- Secrets & credentials (never commit) ---
.env
.env.*
*.pem
*.key
*.pfx
*.p12
*.kdbx
id_rsa*
id_ed25519*
*credentials*
*secret*
*password*
wazuh-install-files.tar
wazuh-passwords.txt

# --- Raw / unsanitized evidence & logs ---
# Only evidence/sanitized/ is meant to be committed.
evidence/*
!evidence/sanitized/
*.log
*.evtx
*.pcap
*.pcapng

# --- VM artifacts (large, machine-specific) ---
*.vdi
*.vmdk
*.vhd
*.vhdx
*.ova
*.ovf
*.iso
*.sav

# --- Local Claude Code settings (personal, not shared) ---
.claude/settings.local.json

# --- OS / editor clutter ---
Thumbs.db
desktop.ini
.DS_Store
.vscode/
*.swp
